# ---- Database -------------------------------------------------------------
# SQLite by default (zero-config local dev). The `db/` folder lives at the
# repo root, git-ignored. A RELATIVE `file:` URL is resolved against
# prisma/schema.prisma — exactly like the Prisma CLI — so `file:../db/custom.db`
# points at <repo>/db/custom.db for the CLI (migrate/seed), `next build`, and
# the running server alike, regardless of the process working directory.
# (src/lib/db-path.ts implements this resolution; tests/db-path.test.ts
# pins the contract.)
# For production, an ABSOLUTE path is still recommended — see
# docs/DEPLOYMENT.md §4.
# To use PostgreSQL:
#   1. Set provider = "postgresql" in prisma/schema.prisma
#   2. Set DATABASE_URL to a PostgreSQL connection string
#   3. bun run db:push && bun run db:seed
DATABASE_URL="file:../db/custom.db"
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/financial_dashboard

# Set to "1" to skip the optional LLM polish of AI-insight records and keep
# the deterministic drafts (hermetic gates). The Playwright E2E webServer
# sets this; production leaves it unset. See src/app/api/ai/insights/route.ts.
# FINARA_INSIGHTS_LLM_OFF="1"

# The deployable site origin (round 17; round 18 also resolves twitter:url
# through it). Resolves the metadataBase, the og:url/canonical links, the
# twitter:url meta, and the sitemap.xml/robots.txt URLs against it.
# Unset defaults to http://localhost:3000 — set it to the public origin
# (e.g. https://finara.example.com) in production deployments.
# NEXT_PUBLIC_SITE_URL="https://your-deployment.example.com"
