# SQLite database location (Prisma resolves relative to prisma/schema.prisma).
# The db/ directory keeps the runtime database; it is gitignored.
DATABASE_URL="file:../db/custom.db"

# Set to "1" to skip the optional LLM polish of AI-insight records and keep
# the deterministic drafts (hermetic gates). The Playwright E2E webServer
# sets this; production leaves it unset. See src/app/api/ai/insights/route.ts.
# FINARA_INSIGHTS_LLM_OFF="1"
